# .env.example — Vorlage. Kopieren nach .env und mit echten Werten befüllen.
# NIEMALS die ausgefüllte .env committen (siehe .gitignore).
# Erklärung jeder Variable: SETUP.md, Schritt 2.

# --- Core Database ---
MASTER_DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- MinIO (Storage) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Resend (E-Mail: GoTrue-SMTP, Uptime-Kuma-Alerts, Disk-Check) ---
RESEND_API_KEY=re_CHANGE_ME

# --- Cloudflare Tunnel (Admin-Zugriff ohne offenen Port) ---
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_from_cloudflare_zero_trust_dashboard

# --- Provisioning Agent ---
PROVISIONING_AGENT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Verbindungsziel fuer normalen App-Traffic (Transaction-Pooling).
PGBOUNCER_HOST=pgbouncer
# Verbindungsziel fuer DDL/Provisioning (CREATE DATABASE, CREATE ROLE).
# MUSS direkt auf Postgres zeigen: PgBouncer laeuft mit POOL_MODE=transaction und
# laesst CREATE DATABASE nicht durch. Der Provisioning Agent nutzt ausschliesslich
# diesen Host, das Dashboard ausschliesslich PGBOUNCER_HOST.
ADMIN_DB_HOST=core-postgres

# --- Deployment Engine (neu) ---
# 256-bit Key für AES-256-GCM-Verschlüsselung von project_env_vars & minio_secret_key.
# WICHTIG: bei Verlust sind alle verschlüsselten Werte in der DB unbrauchbar (siehe 10_env_reference.md § 5.2).
ENCRYPTION_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
VPS_PUBLIC_IP=CHANGE_ME_public_ipv4_deines_servers

# --- Traefik / Let's Encrypt ---
ACME_EMAIL=deine-email@example.com

# --- Preview-Domains & GitHub-Webhooks (neu) ---
# Basis-Domain für automatische Tenant-/Preview-Subdomains: <slug>-<random>.<PLATFORM_DOMAIN>
# Kostenlos (Let's Encrypt/Cloudflare-Zertifikate sind pro Subdomain gratis, kein
# Wildcard-Zertifikat nötig). DNS: A-Record für *.PLATFORM_DOMAIN einmalig auf VPS-IP.
PLATFORM_DOMAIN=example.com
# Öffentlich erreichbare Basis-URL des Agent-Webhook-Endpunkts (Traefik-Router,
# NUR /webhooks/* ist public — Rest des Agents bleibt intern). DNS: A-Record für
# webhooks.PLATFORM_DOMAIN auf VPS-IP.
WEBHOOK_PUBLIC_URL=https://webhooks.example.com
# Fine-grained GitHub Personal Access Token, Scope "Webhooks: Read & write", nur
# für Repos die du selbst verbindest. Ohne diesen Wert: Webhook muss manuell in
# GitHub eingetragen werden (URL wird bei Projekt-Erstellung angezeigt).
GITHUB_PAT=CHANGE_ME_github_pat_mit_webhooks_scope

# --- CMS-Modul (Endkunden pflegen ihre Inhalte selbst) ---
# Nur nötig, wenn der CMS-Dienst (cms/) laufen soll. Ohne diese Werte startet
# bootstrap.sh ihn nicht, alles andere funktioniert unverändert.
#
# Verbindung zur Konfigurationsdatenbank. BEWUSST eine eigene, eingeschränkte
# Rolle statt DATABASE_URL (die ist Superuser) — der CMS-Dienst ist der einzige
# öffentlich erreichbare Teil der Plattform. Rolle anlegen: siehe SETUP.md.
CMS_DATABASE_URL=postgres://cms_config:CHANGE_ME@core-postgres:5432/admin_dashboard
# Entschlüsselt die Passwörter der Rollen cms_<slug>. NICHT derselbe Wert wie
# ENCRYPTION_MASTER_KEY: bei einer Kompromittierung des CMS-Dienstes soll dieser
# Schlüssel keine MinIO-/JWT-Secrets der Tenants öffnen.
# openssl rand -hex 32
CMS_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Signiert die Sitzungs-Cookies der Redakteure. Ein Wechsel meldet alle ab.
# openssl rand -hex 32
CMS_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Öffentliche Basis-URL, unter der hochgeladene Dateien ausgeliefert werden
# (Traefik-Router auf core-minio, siehe SETUP.md). Ohne diesen Wert schlägt jeder
# Upload mit einer erklärenden Meldung fehl.
MEDIA_PUBLIC_BASE_URL=https://media.example.com
# Grenzen pro Datei bzw. pro Kunde (Bytes). Default: 10 MB / 2 GB.
# CMS_MAX_UPLOAD_BYTES=10485760
# CMS_MAX_STORAGE_BYTES=2147483648

# --- Besucher-Analytics (Traefik-Accesslog) ---
# Der Provisioning Agent liest den JSON-Accesslog von Traefik ein und zählt daraus
# Aufrufe und Besucher pro Domain (provisioning-agent/src/lib/analytics.ts).
# Voraussetzung: Traefik läuft mit --accesslog (siehe traefik/docker-compose.yml).
# Alle Werte hier sind optional, die Defaults passen für den Normalbetrieb.
#
# Salt für den täglich wechselnden Besucher-Hash. Ohne eigenen Wert wird
# ENCRYPTION_MASTER_KEY verwendet. Ein WECHSEL dieses Werts setzt die
# Besucher-Unterscheidung des laufenden Tages zurück (Aufrufe bleiben korrekt).
# ANALYTICS_SALT=CHANGE_ME_openssl_rand_hex_32
# Pfad zum Accesslog aus Sicht des Agent-Containers.
# ANALYTICS_ACCESS_LOG=/opt/multitenant-platform/traefik/logs/access.log
# Abstand zwischen zwei Ingest-Läufen in Millisekunden.
# ANALYTICS_INTERVAL_MS=60000
# Ab dieser Dateigröße wird der Accesslog rotiert (Bytes, Default 200 MB).
# ANALYTICS_ROTATE_AT_BYTES=209715200
# Aufbewahrung. Besucher-Hashes am kürzesten (größte Tabelle + Datenschutz),
# Tagessummen am längsten (Jahresvergleich, kostet fast nichts).
# ANALYTICS_VISITOR_RETENTION_DAYS=90
# ANALYTICS_DETAIL_RETENTION_DAYS=180
# ANALYTICS_DAILY_RETENTION_DAYS=730

# --- GoDaddy (optional, für automatisches DNS-Setup bei Custom-Domains, Phase 3) ---
# Aus dem GoDaddy Developer Portal (https://developer.godaddy.com/keys) — PRODUKTIONS-Keys,
# nicht die OTE/Test-Keys, sonst schlägt jeder Request fehl. Ohne diese Werte funktioniert
# alles wie bisher: nur die manuelle A-Record-Anleitung wird angezeigt.
GODADDY_API_KEY=CHANGE_ME
GODADDY_API_SECRET=CHANGE_ME

# --- Backups (rclone, siehe backups/backup-script.sh — Storage-Anbieter frei wählbar) ---
# Beispiel unten: Backblaze B2 (10 GB dauerhaft kostenlos, "b2" als rclone-Remote-Typ).
# Genauso mit jedem anderen rclone-Remote nutzbar (S3, Hetzner Storage Box, SFTP, ...) —
# einfach `rclone config` mit dem gewünschten Anbieter ausführen und Remote-Namen unten
# in RCLONE_REMOTE_PATH eintragen.
# Verschlüsselungs-Keypair einmalig erzeugen: age-keygen -o backups/age-identity.txt
BACKUP_AGE_PUBLIC_KEY=age1CHANGE_ME_public_key_aus_age_keygen_output
BACKUP_AGE_IDENTITY_FILE=/opt/multitenant-platform/backups/age-identity.txt
RCLONE_CONFIG=/opt/multitenant-platform/backups/rclone.conf
RCLONE_REMOTE_PATH=CHANGE_ME_remote-name:bucket-name
# Lokale Aufbewahrung unter backups/files (der Off-Site-Bestand wird über die
# Generationen weiter unten geregelt).
BACKUP_RETENTION_DAYS=3

# --- Off-Site-DR-Bundle (der wichtigste Eintrag in dieser Datei) ---
# Die Sicherungen im Object Storage sind mit age verschlüsselt. Der private
# Schlüssel liegt per Default auf DIESEM Server — also auf genau dem, gegen
# dessen Verlust gesichert wird. Ohne eine Kopie an einem zweiten Ort sind die
# Dateien beim Anbieter nach einem Totalverlust unlesbare Bytes.
#
# Das DR-Bundle besteht aus drei Dateien:
#   backups/age-identity.txt   ohne die ist jedes Backup unlesbar
#   backups/rclone.conf        Zugang zum Object Storage
#   .env                       ENCRYPTION_MASTER_KEY — sonst bleiben alle
#                              verschlüsselten Env-Vars und MinIO-Keys tot
#
# Ablegen in einem Passwortmanager oder einem zweiten, getrennten Konto. Danach
# hier das Datum eintragen (YYYY-MM-DD). Der Agent alarmiert, wenn der Eintrag
# fehlt oder älter als BACKUP_DR_BUNDLE_MAX_AGE_DAYS ist.
BACKUP_DR_BUNDLE_CONFIRMED_AT=
BACKUP_DR_BUNDLE_MAX_AGE_DAYS=180

# --- Backup-Überwachung (lib/backupHealth.ts) ---
# Ab wann ein fehlendes Backup einen Alarm auslöst. 36h lässt einen
# ausgefallenen Lauf plus die nächste reguläre Nacht zu. Ohne diese Prüfung
# meldet ein Backup nur eigene Fehler — ein Cron, der gar nicht erst läuft,
# bleibt sonst unbemerkt, weil Stille wie Erfolg aussieht.
BACKUP_MAX_AGE_HOURS=36
# Abstand zwischen zwei automatischen Restore-Tests (in Tagen). Der Agent prüft
# alle 6h, ob wieder einer fällig ist, und nimmt jeweils die Datenbank, die am
# längsten nicht geprüft wurde.
BACKUP_RESTORE_TEST_INTERVAL_DAYS=7

# --- Aufbewahrung: welches Modell? ---
# generations = Großvater-Vater-Sohn. Lange Rückschau (bis 180 Tage), der
#               Platzbedarf wächst aber mit der Zeit. Für bezahlten Speicher.
# count       = die letzten N Läufe, zusätzlich gedeckelt durch ein
#               Speicherbudget. Für ein festes Gratiskontingent (z. B. die
#               10 GB bei Cloudflare R2) das passende Modell.
BACKUP_RETENTION_MODE=generations

# --- Variante "generations" ---
# Dateien landen je nach Datum unter daily/, weekly/ (sonntags) oder monthly/
# (am Monatsersten); jede Generation räumt sich getrennt auf. Ein Schaden, der
# erst nach zwei Wochen auffällt — schleichende Korruption, ein versehentliches
# DELETE —, ist mit reiner Tagesaufbewahrung nicht mehr rückholbar.
BACKUP_DAILY_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_DAYS=28
BACKUP_MONTHLY_RETENTION_DAYS=180

# --- Variante "count" ---
# Ein "Lauf" ist alles, was eine Nacht erzeugt: Globals, jede Datenbank, MinIO,
# Config. Gelöscht wird immer ein vollständiger Lauf, nie eine einzelne Datei —
# ein Lauf ohne Globals oder ohne MinIO wäre im Ernstfall wertlos und sähe
# trotzdem wie ein Backup aus.
#
# BACKUP_MAX_TOTAL_BYTES ist eine HARTE Grenze und wird nie überschritten:
# Das Backup erzeugt erst alles lokal, kennt damit die echte Größe des Laufs,
# räumt dann so viel weg wie nötig — notfalls den gesamten Altbestand — und
# lädt erst danach hoch. Passt der Lauf nicht einmal allein hinein, bleibt
# alles unberührt und es gibt einen Alarm.
BACKUP_KEEP_RUNS=3
# 9 GB — bewusst unter den 10 GB des R2-Gratiskontingents, als Puffer.
BACKUP_MAX_TOTAL_BYTES=9000000000

# --- Dashboard (Next.js) ---
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
NEXTAUTH_URL=https://admin.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash
PROVISIONING_AGENT_URL=http://provisioning-agent:3001
DATABASE_URL=postgres://postgres:CHANGE_ME@pgbouncer:5432/admin_dashboard

# Resource-Tiers pro Tarif (mem_limit/cpus für GoTrue+PostgREST-Container)
# TODO: Werte für 8GB-VPS (statt geplanter 16GB) neu kalkulieren, aktuell nur Platzhalter aus Blueprint
STARTER_POSTGREST_MEM=64m
STARTER_POSTGREST_CPUS=0.25
STARTER_GOTRUE_MEM=128m
STARTER_GOTRUE_CPUS=0.25

BUSINESS_POSTGREST_MEM=128m
BUSINESS_POSTGREST_CPUS=0.5
BUSINESS_GOTRUE_MEM=128m
BUSINESS_GOTRUE_CPUS=0.25

PREMIUM_POSTGREST_MEM=256m
PREMIUM_POSTGREST_CPUS=0.5
PREMIUM_GOTRUE_MEM=256m
PREMIUM_GOTRUE_CPUS=0.5


# PgBouncer AUTH_QUERY (Audit §5) — Passwort der Rolle pgbouncer_auth
PGBOUNCER_AUTH_PASSWORD=CHANGE_ME_openssl_rand_hex_24
