{"nodes": [{"id": "architecture_md", "label": "Architecture Overview", "file_type": "document", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "db_kunden_table", "label": "kunden table", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "db_provisioned and db_enabled kept as separate flags so the database layer is optional and switchable after creation: disabling is just docker compose down (RAM freed, data untouched, dashboard table/SQL editor keeps working via PgBouncer)."}, {"id": "db_domains_table", "label": "domains table", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "db_analytics_tables", "label": "analytics aggregate tables (analytics_daily/_page_views/_referrers/_visitors)", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No IP or user-agent is stored; the visitor hash salt rotates daily, so a visitor is recognizable only within one day \u2014 'visitors' over a range is the sum of daily values, not a distinct-person count."}, {"id": "db_migration_19_optional_database", "label": "Migration 19: optional database", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "concept_rate_limiting_cf_connecting_ip", "label": "Rate limiting keyed on Cf-Connecting-Ip", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learned from a load test: keying on the TCP peer failed because behind Cloudflare that peer is always one of a handful of edge IPs, spreading a limit across many buckets \u2014 600 requests in 5s against a 20/s limit let 576 through. After switching to the Cf-Connecting-Ip header, the same test yields 463/600 as 429, matching the theoretical burst+rate value."}, {"id": "concept_project_network_runtime_state", "label": "Per-project Docker network as runtime-only state", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app-<slug>-net membership is created at deploy time (ensureProjectNetwork) and exists only as live Docker daemon state \u2014 it's in no docker-compose.yml. Recreating Traefik, the agent, or MinIO rebuilds their networks from the compose file and the project networks are lost, causing silent 504s. The agent re-establishes these connections for all projects on every start."}, {"id": "concept_github_webhook_deploy_flow", "label": "GitHub webhook deploy routing", "file_type": "concept", "source_file": "ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The webhook router is mounted under prefix '/webhooks' with an inner route named '/github/:projectId'; an earlier version put the full path in the inner route too, so the effective endpoint was /webhooks/webhooks/... and GitHub always got 401 \u2014 a push never triggered a deployment."}], "edges": [{"source": "architecture_md", "target": "db_migration_19_optional_database", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.85}, {"source": "dashboard_docker_compose_dashboard", "target": "provisioning_agent_docker_compose_provisioning_agent", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.9}, {"source": "provisioning_agent_docker_compose_provisioning_agent", "target": "minio_docker_compose_minio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.8}, {"source": "provisioning_agent_docker_compose_provisioning_agent", "target": "db_kunden_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.8}, {"source": "provisioning_agent_docker_compose_provisioning_agent", "target": "concept_github_webhook_deploy_flow", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.85}, {"source": "provisioning_agent_docker_compose_provisioning_agent", "target": "concept_project_network_runtime_state", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.85}, {"source": "traefik_docker_compose_traefik", "target": "concept_project_network_runtime_state", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.6, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.5}, {"source": "minio_docker_compose_minio", "target": "concept_project_network_runtime_state", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.6, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.5}, {"source": "traefik_docker_compose_traefik", "target": "concept_rate_limiting_cf_connecting_ip", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "ARCHITECTURE.md", "source_location": null, "weight": 0.85}, {"source": "provisioning_agent_docker_compose_provisioning_agent", "target": "provisionin