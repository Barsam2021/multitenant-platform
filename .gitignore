.env
*/.env
**/.env
node_modules/
dist/
.next/
backups/files/*
backups/rclone.conf
core-postgres/init-scripts/auth-schema.sql
kunden-instances/*/docker-compose.yml
deployments/builds/*
!deployments/builds/.gitkeep
deployments/apps/*
!deployments/apps/.gitkeep
traefik/letsencrypt/*
!traefik/letsencrypt/.gitkeep
backups/age-identity.txt
backups/rclone.conf
_backup-*/
_archive-patches/
_schema-live-*.sql
diagnose-*.log
.env.bak-*
*.bak-*
*.bak2
traefik/logs/*
!traefik/logs/.gitkeep
# Laufzeit-Router: schreibt der Provisioning Agent pro Custom-Domain und pro
# oeffentlich geschaltetem Tenant-Dienst (lib/traefikDynamic.ts). Gehoert nicht
# ins Repo — und muss ignoriert sein, damit ein `git clean -fd` beim Aufraeumen
# nicht die Live-Routen aller Kundendomains loescht.
traefik/dynamic/*
!traefik/dynamic/.gitkeep
*.tsbuildinfo
