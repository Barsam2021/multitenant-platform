.env
*/.env
**/.env
node_modules/
dist/
.next/
backups/files/*
backups/rclone.conf
core-postgres/init-scripts/auth-schema.sql
kunden-instances/*/docker-compose.yml
deployments/builds/*
!deployments/builds/.gitkeep
deployments/apps/*
!deployments/apps/.gitkeep
traefik/letsencrypt/*
!traefik/letsencrypt/.gitkeep
backups/age-identity.txt
backups/rclone.conf
_backup-*/
_archive-patches/
_schema-live-*.sql

# Ungetrackte Datenbank-Auszuege aus dem Live-Betrieb. Sie enthalten echte
# Kundendaten (Name, E-Mail, Telefon in clients/quiz_leads/roi_leads/
# submissions) und gehoeren nicht ins Repo. Ohne diese Zeilen genuegt ein
# einzelnes `git add -A`, um sie dauerhaft in die History zu schreiben —
# herausholen ginge danach nur per History-Rewrite. Gleiche Klasse wie
# _schema-live-*.sql darueber, nur ohne gemeinsames Namensmuster.
up2web-schema.sql
dashboard/up2site-data.sql

diagnose-*.log
.env.bak-*
*.bak-*
*.bak2
traefik/logs/*
!traefik/logs/.gitkeep
# Laufzeit-Router: schreibt der Provisioning Agent pro Custom-Domain und pro
# oeffentlich geschaltetem Tenant-Dienst (lib/traefikDynamic.ts). Gehoert nicht
# ins Repo — und muss ignoriert sein, damit ein `git clean -fd` beim Aufraeumen
# nicht die Live-Routen aller Kundendomains loescht.
traefik/dynamic/*
!traefik/dynamic/.gitkeep
*.tsbuildinfo

# graphify: der Wissensgraph selbst (graph.json, Report, Community-Labels)
# gehoert ins Repo — davon lebt die Einrichtung. Ignoriert wird nur, was
# maschinen- oder laufabhaengig ist oder sich in Sekunden neu erzeugen laesst.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_analysis.json
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
!graphify-out/.graphify_semantic_marker
# Semantik-Cache mitnehmen: er ist inhaltsbasiert und erspart einem frischen
# Clone die LLM-Extraktion der Dokumentation.
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/
